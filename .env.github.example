# GitHub Integration Configuration Template
# Copy this file to .env.customer-NAME and add GitHub credentials

# Customer identification
CUSTOMER_NAME=customer-01
DASHBOARD_PORT=9120

# Telegram configuration (unique per customer)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# GitHub Integration
GITHUB_TOKEN=ghp_your-github-personal-access-token-here
GITHUB_USERNAME=your-github-username
GITHUB_DEFAULT_BRANCH=main

# GitHub repositories (comma-separated)
GITHUB_REPOS=org/repo1,org/repo2,org/repo3

# GitHub webhook configuration (optional)
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here
GITHUB_WEBHOOK_URL=https://your-domain.com/webhook

# Codex authentication
# Note: Each customer instance needs separate Codex authentication
# Run: docker-compose exec gateway hermes auth add openai-codex

# Optional: Mattermost configuration
MATTERMOST_TOKEN=your-mattermost-token-here
MATTERMOST_URL=https://your-mattermost-server.com

# Custom data volume name
CUSTOMER_DATA_VOLUME=hermes-customer-01-data
